# ─────────────────────────────────────────────
# platform-core — Environment Configuration
# Copy to .env and populate all values before running.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
SERVICE_NAME=AegisCore
SERVICE_VERSION=1.0.0
# BASELINE | REGULATED
COMPLIANCE_PROFILE=BASELINE

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://aegis:changeme@localhost:5432/aegiscore
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false
# Used by Flyway migrations
FLYWAY_URL=jdbc:postgresql://localhost:5432/aegiscore
FLYWAY_USER=platform
FLYWAY_PASSWORD=changeme
FLYWAY_SCHEMAS=public
FLYWAY_LOCATIONS=filesystem:migrations/sql

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=platform:
# JWT jti replay protection TTL (seconds)
REDIS_JTI_TTL=3600

# ── Auth / OIDC ───────────────────────────────
OIDC_ISSUER=https://your-auth-provider.example.com
OIDC_AUDIENCE=platform-core
OIDC_JWKS_URI=https://your-auth-provider.example.com/.well-known/jwks.json
# Internal service-to-service shared secret (rotate regularly)
INTERNAL_SERVICE_SECRET=changeme-use-vault-in-production

# ── AWS ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/platform-events
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/platform-events-dlq
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME_SECONDS=20

# S3 Audit Bucket (Object Lock / WORM)
S3_AUDIT_BUCKET=platform-audit-worm
S3_AUDIT_PREFIX=audit/
S3_AUDIT_REGION=us-east-1

# KMS
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id
KMS_KEY_ALIAS=alias/platform-core

# ── Vault ────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=changeme-use-approle-in-production
VAULT_NAMESPACE=platform
VAULT_MOUNT_PATH=secret
VAULT_ROLE_ID=changeme
VAULT_SECRET_ID=changeme

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_REQUESTS_AUTH=1000
RATE_LIMIT_BLOCK_DURATION_MS=300000

# ── OpenTelemetry ────────────────────────────
OTEL_SERVICE_NAME=AegisCore
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORT_INTERVAL=30000

# ── AI Safety ────────────────────────────────
AI_SAFETY_PII_FILTER=true
AI_SAFETY_ADVERSARIAL_DETECTION=true
AI_SAFETY_MAX_RESPONSE_TOKENS=4096
AI_SAFETY_BLOCK_MEDICAL_INTENT=true
# Comma-separated list of allowed LLM providers
AI_ALLOWED_PROVIDERS=anthropic,openai

# ── Metering ─────────────────────────────────
METERING_ENABLED=true
METERING_FLUSH_INTERVAL_MS=5000
BILLING_WEBHOOK_URL=https://billing.example.com/hooks/usage
BILLING_WEBHOOK_SECRET=changeme

# ── SBOM / Supply Chain ───────────────────────
COSIGN_KEY_PATH=./cosign.key
COSIGN_CERT_PATH=./cosign.crt
SBOM_OUTPUT_PATH=./sbom.spdx.json

# ── Health ────────────────────────────────────
HEALTH_CHECK_TIMEOUT_MS=5000
READINESS_INCLUDE_DB=true
READINESS_INCLUDE_REDIS=true
READINESS_INCLUDE_VAULT=true
