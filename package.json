{
  "name": "AegisCore2",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "platform/*",
    "apps/*",
    "platform/collaboration",
    "features/*"
  ],
  "scripts": {
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "20.19.40",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "pino": "^10.3.1",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5",
    "uuid": "^14.0.2",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "express": "4.22.1",
    "express-rate-limit": "^8.6.2",
    "zod": "3.25.76"
  }
}
