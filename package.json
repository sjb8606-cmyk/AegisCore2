{
  "name": "AegisCore2",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "platform/*",
    "apps/*",
    "platform/collaboration",
    "features/*"
  ],
  "scripts": {
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "1.6.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "@types/node": "20.19.40"
  },
  "dependencies": {
    "express": "4.22.1",
    "zod": "3.25.76"
  }
}
