{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@platform/auth": ["./platform/auth/src/index.ts"],
      "@platform/tenancy": ["./platform/tenancy/src/index.ts"],
      "@platform/audit": ["./platform/audit/src/index.ts"],
      "@platform/queues": ["./platform/queues/src/index.ts"],
      "@platform/observability": ["./platform/observability/src/index.ts"],
      "@platform/security": ["./platform/security/src/index.ts"],
      "@platform/metering": ["./platform/metering/src/index.ts"],
      "@platform/ai-safety": ["./platform/ai-safety/src/index.ts"],
      "@platform/utils": ["./platform/utils/src/index.ts"],
      "@platform/app-loader": ["./platform/app-loader/src/index.ts"],
      "@platform/lot-traceability": ["./platform/lot-traceability/src/index.ts"],
      "@platform/hash-chain": ["./platform/hash-chain/src/index.ts"],
      "@platform/recall-engine": ["./platform/recall-engine/src/index.ts"],
      "@platform/temperature-engine": ["./platform/fisheries/temperature-engine/src/index.ts"],
      "@platform/hold-release": ["./platform/fisheries/hold-release/src/index.ts"],
      "@platform/live-holding": ["./platform/fisheries/live-holding/src/index.ts"],
      "@platform/species-registry": ["./platform/fisheries/species-registry/src/index.ts"],
      "@platform/labelling-engine": ["./platform/fisheries/labelling-engine/src/index.ts"],
      "@platform/delight": ["./platform/delight/src/index.ts"],
      "@platform/ai-chat": ["./platform/ai-chat/src/index.ts"],
      "@platform/ai-gateway": ["./platform/ai-gateway/src/index.ts"],
      "@platform/crud-kernel": ["./platform/crud-kernel/src/index.ts"],
      "@platform/rules": ["./platform/rules/src/index.ts"],
      "@platform/bot-registry": ["./platform/bot-registry/src/index.ts"],
      "@platform/bot-runtime": ["./platform/bot-runtime/src/index.ts"],
      "@platform/aegis-swarm": ["./platform/aegis-swarm/src/index.ts"],
      "@features/forms": ["./platform/forms/src/index.ts"],
      "@features/sandbox": ["./platform/sandbox/src/index.ts"],
      "@features/translator": ["./platform/translator/src/index.ts"],
      "@features/json-translator": ["./platform/json-translator/src/index.ts"],
      "@features/changelog": ["./platform/changelog/src/index.ts"],
      "@features/snapshot": ["./platform/snapshot/src/index.ts"],
      "@features/diff-engine": ["./platform/diff-engine/src/index.ts"],
      "@features/synthetic": ["./platform/synthetic/src/index.ts"],
      "@features/scenarios": ["./platform/scenarios/src/index.ts"],
      "@features/verifier": ["./platform/verifier/src/index.ts"]
    }
  },
  "include": ["platform/**/*.ts", "apps/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
