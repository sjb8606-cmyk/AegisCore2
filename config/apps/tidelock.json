{
  "app_id": "tidelock",
  "name": "TIDELOCK",
  "version": "1.0.0",
  "description": "Seafood processing operations platform \u2014 yield tracking, compliance export, scheduling, and traceability.",
  "tenant_id": "660f9500-f30c-52e5-b827-557766550001",
  "status": "active",
  "cores": [
    "species-registry",
    "shipment-intake",
    "processing-batch",
    "yield-engine",
    "loss-alert",
    "compliance-reporter",
    "shift-huddle",
    "production-verifier",
    "recall-engine",
    "temperature-engine"
  ],
  "config": {
    "shipment-intake": {
      "enabled": true,
      "unit": "kg",
      "species_tracking": true
    },
    "compliance-reporter": {
      "enabled": true,
      "frameworks": [
        "HACCP",
        "DFO_Canada",
        "CFIA"
      ],
      "auto_export_format": "csv",
      "retention_days": 2555
    },
    "yield-engine": {
      "enabled": true,
      "yield_variance_alerts": true
    },
    "shift-huddle": {
      "enabled": true,
      "shift_types": [
        "processing",
        "QC",
        "maintenance",
        "cleaning"
      ]
    }
  },
  "api_keys_required": [
    "ANTHROPIC_API_KEY"
  ],
  "routes": [
    {
      "path": "/api/species-registry",
      "method": "GET|POST",
      "auth": true
    },
    {
      "path": "/api/shipment-intake",
      "method": "GET|POST",
      "auth": true
    },
    {
      "path": "/api/processing-batch",
      "method": "GET|POST",
      "auth": true
    },
    {
      "path": "/api/yield-engine",
      "method": "GET|POST",
      "auth": true
    },
    {
      "path": "/api/loss-alert",
      "method": "GET",
      "auth": true
    },
    {
      "path": "/api/compliance-reporter",
      "method": "GET|POST",
      "auth": true
    },
    {
      "path": "/api/shift-huddle",
      "method": "GET|POST|PATCH",
      "auth": true
    },
    {
      "path": "/api/production-verifier",
      "method": "GET|POST",
      "auth": true
    },
    {
      "path": "/api/recall-engine/:lotId",
      "method": "GET",
      "auth": true
    },
    {
      "path": "/api/recall-engine/:lotId/hold",
      "method": "POST",
      "auth": true
    },
    {
      "path": "/api/temperature-engine/threshold",
      "method": "POST",
      "auth": true
    },
    {
      "path": "/api/temperature-engine/:lotId/reading",
      "method": "POST",
      "auth": true
    },
    {
      "path": "/api/temperature-engine/:lotId/readings",
      "method": "GET",
      "auth": true
    }
  ],
  "created_at": "2026-06-25T00:00:00Z",
  "owner": "Ruthless Technologies",
  "pilot_contact": "Sylvio L\u00e9ger"
}