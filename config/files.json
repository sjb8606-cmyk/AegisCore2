{
  "enabled": true,
  "tiers": {
    "versioning": false,
    "sharing": true,
    "virusScan": false,
    "encryptionAtRest": true,
    "auditTrail": true
  },
  "limits": {
    "maxFileSizeMb": 20,
    "maxStorageGb": 5,
    "allowedMimeTypes": ["application/pdf", "image/png", "image/jpeg"]
  },
  "storage": {
    "provider": "s3",
    "bucket": "ruthless-platform-prod",
    "region": "ca-central-1"
  }
}
