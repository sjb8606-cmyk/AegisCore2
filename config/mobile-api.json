{
  "enabled": true,
  "tiers": {
    "deviceRegistration": true,
    "pushTokenManagement": true,
    "compressedResponses": true,
    "refreshTokenRotation": true,
    "offlineSyncHooks": true,
    "versionEnforcement": true,
    "perDeviceRateLimiting": true,
    "deepLinkRouting": true,
    "mobileAnalyticsIngestion": true
  },
  "limits": {
    "devicesPerTenant": 1000000,
    "pushTokensPerDevice": 3,
    "syncQueueDepthPerDevice": 500,
    "analyticsEventsPerMinute": 1000
  },
  "thresholds": {
