{
  "enabled": true,
  "tiers": {
    "domainRegistration": true,
    "dnsVerification": true,
    "tlsProvisioning": true,
    "domainRouting": true,
    "subdomainSupport": true,
    "autoRenewal": true
  },
  "limits": {
    "domainsPerTenant": 25,
    "verificationAttemptsPerDomain": 10
  },
  "thresholds": {
    "dnsVerificationTimeoutMs": 30000,
    "certRenewalDaysAhead": 30
  }
}
